{
  "name": "paperclip-plugin-openshell",
  "version": "0.1.0",
  "description": "Paperclip sandbox-provider plugin that provisions NVIDIA OpenShell sandboxes (e.g. Firecracker microVMs via openshell-firecracker) as Paperclip execution environments.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nvidia/openshell-sdk": "*",
    "@paperclipai/plugin-sdk": "2026.1023.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-miles/paperclip-openshell.git"
  }
}
